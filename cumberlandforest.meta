<?xml version="1.0" encoding="UTF-8"?>	
<CDispatchData>
	<BountyResponses>
		<BountyDispatch>
			<Name>LAW_WILDERNESS_CUMBERLAND_FOREST</Name>
			<RandomWeight value="1.0" />
			<RequiredRegion>LAW_REGION_CUMBERLAND_FOREST</RequiredRegion>
			<RequiredCooldowns>
				<Item>DefaultCooldown</Item>
			</RequiredCooldowns>
			<Flags>CantBeCleared</Flags>
			<CombatInfoOverride>LAW_WILDERNESS</CombatInfoOverride>
			<DispatchPhases>
				
				<!-- Phase: Riders -->
				<Phase>
					<Name>Riders</Name>
					<!-- <ScriptHash>BLOODHOUNDS</ScriptHash>
					<ScriptEventFlags>SF_SpecialEvent4</ScriptEventFlags> -->
					<GroupMultiplier value="0.3"/>
					<ConditionalSpawnDelays>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_NEAR</Name>
							</Condition>
							<SpawnDelay value="90.00"/>
						</Item>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_MID</Name>
							</Condition>
							<SpawnDelay value="110.00"/>
						</Item>
					</ConditionalSpawnDelays>
					<SpawnDelay value="120.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>CumberlandOnFootCarbineVet</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>CumberlandOnFootCarbine</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
								<MinSeverityMultiplier value="0.0f"/>
								<MaxSeverityMultiplier value="3.0f"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
				
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_LOW_SEVERITY_ESCALATION_WILDERNESS</Name>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<!--Switch to Reinforcements phase, always-->
						<PhaseOption>
							<Name>Reinforcements</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<!-- Phase: Reinforcements -->
				<Phase>
					<Name>Reinforcements</Name>
					<GroupMultiplier value="0.3"/>
					<ConditionalSpawnDelays>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_NEAR</Name>
							</Condition>
							<SpawnDelay value="100.00"/>
						</Item>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_MID</Name>
							</Condition>
							<SpawnDelay value="120.00"/>
						</Item>
					</ConditionalSpawnDelays>
					<SpawnDelay value="120.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>CumberlandOnFootCarbine</Preset>
								<MinNumPeds value="2"/>
								<MaxNumPeds value="4"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>PoliceDog</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<!-- Additional dogs per crime severity -->
							<DispatchGroup>
								<SelectionConditions>
									<Condition type="CAIConditionIncidentSeverity">
										<MinSeverity>High</MinSeverity>
									</Condition>
								</SelectionConditions>
								<Preset>CumberlandOnFootCarbineVet</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<DispatchGroup>
								<SelectionConditions>
									<Condition type="CAIConditionWantedLevel">
										<WantedLevelLowerBound value="4"/>
									</Condition>
								</SelectionConditions>
								<Preset>CumberlandOnFootCarbineVet</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
					
					<PhaseEndConditions>
						<Condition type="CAIConditionOr">
							<Conditions>
								<Condition type="CAIConditionAnd">
									<Conditions>
										<Condition type="CAIConditionTimePlayerHostileInDispatchPhase">
											<LowerBound value="50000"/>
										</Condition>
										<Condition type="CAIConditionPedsRemainingInCurrentIncident">
											<UpperBound value="2"/>
										</Condition>
									</Conditions>
								</Condition>
								<Condition type="CAIConditionAnd">
									<Conditions>
										<Condition type="CAIConditionTimePlayerHostileInDispatchPhase">
											<LowerBound value="40000"/>
										</Condition>
										<Condition type="CAIConditionPedsRemainingInCurrentIncident">
											<UpperBound value="1"/>
										</Condition>
									</Conditions>
								</Condition>
								<Condition type="CAIConditionAnd">
									<Conditions>
										<Condition type="CAIConditionTimePlayerHostileInDispatchPhase">
											<LowerBound value="32000"/>
										</Condition>
										<Condition type="CAIConditionHumanPedsRemainingInCurrentIncident">
											<UpperBound value="0"/>
										</Condition>
									</Conditions>
								</Condition>
							</Conditions>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<PhaseOption>
							<Name>FinalWave</Name>
						</PhaseOption>
					</NextPhases>		
				</Phase>
				
				<!-- Phase: FinalWave -->
				<Phase>
					<Name>FinalWave</Name>
					<GroupMultiplier value="0.3"/>
					<ConditionalSpawnDelays>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_NEAR</Name>
							</Condition>
							<SpawnDelay value="80.00"/>
						</Item>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_MID</Name>
							</Condition>
							<SpawnDelay value="100.00"/>
						</Item>
					</ConditionalSpawnDelays>
					<SpawnDelay value="100.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>CumberlandOnFootCarbine</Preset>
								<MinNumPeds value="2"/>
								<MaxNumPeds value="5"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
					
					<NextPhases>
						<!-- End Response -->
					</NextPhases>	
				</Phase>
				
			</DispatchPhases>
		</BountyDispatch>
	</BountyResponses>
	<CleanUpDispatchPedPresets>
		<Item>RiderRuralFoothills</Item>
	</CleanUpDispatchPedPresets>
</CDispatchData>