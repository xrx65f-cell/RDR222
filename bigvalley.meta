<?xml version="1.0" encoding="UTF-8"?>	
<CDispatchData>
	<BountyResponses>
		<BountyDispatch>
			<Name>LAW_WILDERNESS_BIG_VALLEY</Name>
			<RandomWeight value="1.0" />
			<RequiredRegion>LAW_REGION_BIG_VALLEY</RequiredRegion>
			<RequiredCooldowns>
				<Item>DefaultCooldown</Item>
			</RequiredCooldowns>
			<Flags>CantBeCleared</Flags>
			<CombatInfoOverride>LAW_WILDERNESS</CombatInfoOverride>
			<DispatchPhases>
				
				<!-- Phase: Riders -->
				<Phase>
					<Name>Riders</Name>
					<GroupMultiplier value="0.3"/>
					<ConditionalSpawnDelays>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_NEAR</Name>
							</Condition>
							<SpawnDelay value="35.00"/>
						</Item>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_MID</Name>
							</Condition>
							<SpawnDelay value="45.00"/>
						</Item>
					</ConditionalSpawnDelays>
					<SpawnDelay value="30.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderStraw</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>RiderStraw</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
								<MinSeverityMultiplier value="0.0f"/>
								<MaxSeverityMultiplier value="3.0f"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
				
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_LOW_SEVERITY_ESCALATION_WILDERNESS</Name>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<!--Switch to Reinforcements phase, always-->
						<PhaseOption>
							<Name>Reinforcements</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<!-- Phase: Reinforcements -->
				<Phase>
					<Name>Reinforcements</Name>
					<GroupMultiplier value="0.3"/>
					<ConditionalSpawnDelays>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_NEAR</Name>
							</Condition>
							<SpawnDelay value="45.00"/>
						</Item>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_MID</Name>
							</Condition>
							<SpawnDelay value="60.00"/>
						</Item>
					</ConditionalSpawnDelays>
					<SpawnDelay value="30.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderStrawCow</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</DispatchPedGroups>
						
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderStrawCow</Preset>
								<RandomWeight value="0.5"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>RiderStrawCow</Preset>
								<RandomWeight value="0.5f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
					
					<!-- If we kill these two waves, then a last "search party" comes out -->
					<!-- If we haven't killed them, don't send anybody else -->
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_RESPONSE_FINISHED_WILDERNESS</Name>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<PhaseOption>
							<Name>FinalWave</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<!-- Phase: FinalWave -->
				<Phase>
					<Name>FinalWave</Name>
					<GroupMultiplier value="0.3"/>
					<ConditionalSpawnDelays>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_NEAR</Name>
							</Condition>
							<SpawnDelay value="30.00"/>
						</Item>
						<Item>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_PLAYER_DISTANCE_TO_TOWN_MID</Name>
							</Condition>
							<SpawnDelay value="40.00"/>
						</Item>
					</ConditionalSpawnDelays>
					<SpawnDelay value="45.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>BountyHunter</Preset>
								<MinNumPeds value="2"/>
								<MaxNumPeds value="4"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
					
					<NextPhases>
						<!-- End Response -->
					</NextPhases>	
				</Phase>
				
			</DispatchPhases>
		</BountyDispatch>
	</BountyResponses>
	<CleanUpDispatchPedPresets>
		<Item>RiderRuralLowlands</Item>
	</CleanUpDispatchPedPresets>
</CDispatchData>