<?xml version="1.0" encoding="UTF-8"?>	
<CDispatchData>
	<BountyResponses>
		<BountyDispatch>
			<Name>LAW_LOCAL_ANNESBURG</Name>
			<RandomWeight value="1.0" />
			<RequiredRegion>LAW_REGION_ANNESBURG</RequiredRegion>
			<RequiredCooldowns>
				<Item>DefaultCooldown</Item>
			</RequiredCooldowns>
			<DispatchPhases>
				
				<!-- Phase: On Foot -->
				<Phase>
					<Name>OnFoot</Name>
					<GroupMultiplier value="0.4f"/>

					<!--Phase peds--> 
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>OnFootJames</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>						
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED_LOW_SEVERITY</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
					
					<!--Phase end conditions-->
					<PhaseEndConditions>
						<Condition type="CAIConditionOr">
							<Conditions>
								<Condition type="CAIConditionReferenced">
									<Name>DISPATCH_LOW_SEVERITY_ESCALATION_TOWN</Name>
								</Condition>
								<Condition type="CAIConditionReferenced">
									<Name>DISPATCH_LOW_SEVERITY_RESTART_TOWN</Name>
								</Condition>
							</Conditions>
						</Condition>
					</PhaseEndConditions>

					<!--Next phase options-->
					<NextPhases>
						<PhaseOption>
							<Condition type="CAIConditionIncidentSeverity">
								<MinSeverity>High</MinSeverity>
							</Condition>
							<Name>HighSeverityReinforcements</Name>
						</PhaseOption>
						<PhaseOption>
							<Condition type="CAIConditionReferenced">
								<Name>DISPATCH_LOW_SEVERITY_ESCALATION_TOWN</Name>
							</Condition>
							<Name>MediumSeverityReinforcements</Name>
						</PhaseOption>
						<PhaseOption>
							<!-- Repeat the current phase if we haven't met the conditions to escalate. -->
							<Condition type="NULL"/>
							<Name>OnFoot</Name>
						</PhaseOption>
					</NextPhases>
				</Phase>
				
				<!-- Phase: MediumSeverityReinforcements -->
				<Phase>
					<Name>MediumSeverityReinforcements</Name>
					<GroupMultiplier value="0.4f"/>
						
					<!--Phase peds--> 
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>OnFootJames</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED_LOW_SEVERITY</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
					
					<!--Phase end conditions-->
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_MEDIUM_SEVERITY_ESCALATION_TOWN</Name>
						</Condition>
					</PhaseEndConditions>

					<!--Next phase options-->
					<NextPhases>
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>HighSeverityReinforcements</Name>
						</PhaseOption>
					</NextPhases>			
				</Phase>
				
				<!-- Phase: High Severity Reinforcements -->
				<Phase>
					<Name>HighSeverityReinforcements</Name>
					<GroupMultiplier value="0.4f"/>
						
					<!--Phase peds--> 
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>OnFootJames</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<GreedyAcquireCondition type="CAIConditionReferenced">
							<Name>SHOULD_GRAB_AVAILABLE_DISPATCH_PED</Name>
						</GreedyAcquireCondition>
					</DispatchPeds>
					
					<!--Phase end conditions-->
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_HIGH_SEVERITY_ESCALATION_TOWN</Name>
						</Condition>
					</PhaseEndConditions>

					<!--Next phase options-->
					<NextPhases>
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>ASBPhaseControl</Name>
						</PhaseOption>
					</NextPhases>		
				</Phase>

				<!-- Phase: ASBPhaseControl -->				
				<Phase>
					<Name>ASBPhaseControl</Name>
					
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_PHASE_CONTROL_ESCALATION_TOWN</Name>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						
						<!-- PRE-CHECK for SharpShooters -->
						<PhaseOption>
							<!-- Random chance for a SharpShooters wave 3 times, without back to back waves -->
							<Condition type="CAIConditionAnd">
								<Conditions>
									<Condition type="CAIConditionNot">
										<Condition type="CAIConditionIsDispatchPhasePreviousPhase">
											<Phase>SharpShooters</Phase>
										</Condition>
									</Condition>
									<Condition type="CAIConditionNot">
										<Condition type="CAIConditionNumTimesDispatchPhaseSelected">
											<Phase>SharpShooters</Phase>
											<LowerBound value="3"/>
										</Condition>
									</Condition>
									<Condition type="CAIConditionRandom">
										<Chances value="0.2f"/>
									</Condition>
								</Conditions>
							</Condition>
							<Name>SharpShooters</Name>
						</PhaseOption>
						
						<!-- PRE-CHECK for 3 star wanted level-->
						<PhaseOption>
							<Condition type="CAIConditionWantedLevel">
								<WantedLevelLowerBound value="3"/>
							</Condition>
							<Name>Marshals</Name>
						</PhaseOption>
						
						<!-- WildernessRiders -->
						<PhaseOption>
							<Condition type="CAIConditionAnd">
								<Conditions>
									<Condition type="CAIConditionRandom">
										<Chances value="0.25f"/>
									</Condition>
									<Condition type="CAIConditionNumTimesDispatchPhaseSelected">
										<Phase>ASBPhaseControl</Phase>
										<LowerBound value="2"/>
										<UpperBound value="4"/>
									</Condition>
								</Conditions>
							</Condition>
							<Name>WildernessRiders</Name>
						</PhaseOption>
						
						<!-- EndlessRiders -->
						<PhaseOption>
							<Condition type="CAIConditionNumTimesDispatchPhaseSelected">
								<Phase>ASBPhaseControl</Phase>
								<LowerBound value="15"/>
							</Condition>
							<Name>EndlessRiders</Name>
						</PhaseOption>
						
						<!-- DEFAULT: If we fell through everything, reloop to BaseRiders -->
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>BaseRiders</Name>
						</PhaseOption>
					</NextPhases>
				</Phase>
				
				<!-- Phase: BaseRiders -->
				<Phase>
					<Name>BaseRiders</Name>
					<GroupMultiplier value="0.3f"/>
					
					<!-- add a spawn delay so that we don't have insta-triggers upon killing a lawped -->
					<SpawnDelay value="5.00"/>

					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>OnFootTrainG</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>CornOnFootCarbine</Preset>
								<RandomWeight value="0.35"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>ObeseOnFoot</Preset>
								<RandomWeight value="0.30f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>MinerOnFoot</Preset>
								<RandomWeight value="0.35f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
					
					<PhaseEndConditions>
						<Condition type="CAIConditionTimeInDispatchPhase">
							<LowerBound value="2000"/>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<PhaseOption>
							<Name>ASBPhaseControl</Name>
						</PhaseOption>
					</NextPhases>
				</Phase>
				
				<!-- Phase: Solo Dual Wield Guy -->
				<Phase>
					<Name>SharpShooters</Name>

					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderJames</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>						
						</DispatchPedGroups>
					</DispatchPeds>
				
					<PhaseEndConditions>
						<Condition type="CAIConditionTimeInDispatchPhase">
							<LowerBound value="1000"/>
						</Condition>
					</PhaseEndConditions>

					<NextPhases>
						<PhaseOption>
							<Name>ASBPhaseControl</Name>
						</PhaseOption>
					</NextPhases>
				</Phase>

				<!-- Phase: WildernessRiders -->
				<Phase>
					<Name>WildernessRiders</Name>
					<GroupMultiplier value="0.3f"/>

					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderGuard</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</DispatchPedGroups>
					</DispatchPeds>
					
					<PhaseEndConditions>
						<Condition type="CAIConditionTimeInDispatchPhase">
							<LowerBound value="1000"/>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<PhaseOption>
							<Name>ASBPhaseControl</Name>
						</PhaseOption>
					</NextPhases>
				</Phase>
				
				<!-- Phase: Endless Riders -->
				<Phase>
					<Name>EndlessRiders</Name>
					<GroupMultiplier value="0.3f"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderJames</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderJames</Preset>
								<RandomWeight value="0.5f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="3"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
				
					<PhaseEndConditions>
						<Condition type="CAIConditionTimeInDispatchPhase">
							<LowerBound value="1000"/>
						</Condition>
					</PhaseEndConditions>

					<NextPhases>
						<PhaseOption>
							<Name>ASBPhaseControl</Name>
						</PhaseOption>
					</NextPhases>
				</Phase>
				
				<!-- Phase: Marshals -->
				<Phase>
					<Name>Marshals</Name>
					<GroupMultiplier value="0.3f"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderJames</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>OnFootJames</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="3"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>MinerOnFootT</Preset>
								<RandomWeight value="0.5f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>							
							<DispatchGroup>
								<Preset>MinerOnFoot</Preset>
								<RandomWeight value="0.5f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>DriverOnFootCarbine</Preset>
								<RandomWeight value="0.30f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
				
					<PhaseEndConditions>
						<Condition type="CAIConditionTimeInDispatchPhase">
							<LowerBound value="1000"/>
						</Condition>
					</PhaseEndConditions>

					<NextPhases>
						<PhaseOption>
							<!-- End Response -->
						</PhaseOption>
					</NextPhases>
				</Phase>
			</DispatchPhases>
		</BountyDispatch>
	</BountyResponses>
	<CleanUpDispatchPedPresets>
		<Item>RiderFoothills</Item>
	</CleanUpDispatchPedPresets>
</CDispatchData>