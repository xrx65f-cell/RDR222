<?xml version="1.0" encoding="UTF-8"?>	
<CDispatchData>
	<BountyResponses>
		<BountyDispatch>
			<Name>LAW_LOCAL_WAPITI</Name>
			<RandomWeight value="1.0" />
			<RequiredRegion>LAW_REGION_WAPITI</RequiredRegion>
			<RequiredCooldowns>
				<Item>DefaultCooldown</Item>
			</RequiredCooldowns>
			<DispatchPhases>
				
				<!-- Phase: Riders -->
				<Phase>
					<Name>Riders</Name>
					<GroupMultiplier value="0.3"/>
					<SpawnDelay value="25.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>WapitiRiderDefaultCarbine</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</DispatchPedGroups>
					</DispatchPeds>
				
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_LOW_SEVERITY_ESCALATION_WILDERNESS</Name>
						</Condition>
					</PhaseEndConditions>
					
					<!-- Switch to Reinforcements phase -->
					<NextPhases>
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>Reinforcements</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<!-- Phase: Reinforcements -->
				<Phase>
					<Name>Reinforcements</Name>
					<GroupMultiplier value="0.3"/>
					<SpawnDelay value="15.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>WapitiRiderRural</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</DispatchPedGroups>
						
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>WapitiRiderDefaultCarbine</Preset>
								<RandomWeight value="0.5"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>WapitiRiderShotgun</Preset>
								<RandomWeight value="0.5f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
					
					<!--Phase end conditions-->
					<PhaseEndConditions>	
						<Condition type="CAIConditionAnd">
							<Conditions>
								<Condition type="CAIConditionTimeInDispatchPhase">
									<LowerBound value="15000"/>
								</Condition>
								<Condition type="CAIConditionPedsRemainingInCurrentIncident">
									<UpperBound value="1"/>
								</Condition>
							</Conditions>
						</Condition>
					</PhaseEndConditions>
					
					<!-- Go to FinalWave -->
					<NextPhases>
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>FinalWave</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<!-- Phase: FinalWave -->
				<Phase>
					<Name>FinalWave</Name>
					<GroupMultiplier value="0.3"/>
					<SpawnDelay value="20.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>WapitiRiderRural</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>WapitiRiderShotgun</Preset>
								<RandomWeight value="0.35f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>WapitiRiderSniper</Preset>
								<RandomWeight value="0.65f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
					
					<NextPhases>
						<!-- End Response -->
					</NextPhases>	
				</Phase>				
			</DispatchPhases>
		</BountyDispatch>
	</BountyResponses>
	<CleanUpDispatchPedPresets>
		<Item>WapitiRiderDefaultCarbine</Item>
	</CleanUpDispatchPedPresets>
</CDispatchData>