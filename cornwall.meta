<?xml version="1.0" encoding="UTF-8"?>	
<CDispatchData>
	<BountyResponses>
		<BountyDispatch>
			<Name>LAW_LOCAL_CORNWALL</Name>
			<RandomWeight value="1.0" />
			<RequiredRegion>LAW_REGION_CORNWALL</RequiredRegion>
			<RequiredCooldowns>
				<Item>DefaultCooldown</Item>
			</RequiredCooldowns>
			<DispatchPhases>
				
				<!-- Phase: Riders -->
				<Phase>
					<Name>Riders</Name>
					<GroupMultiplier value="0.3"/>
					<SpawnDelay value="25.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>CornOnFootCarbine</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
							<DispatchGroup>
								<Preset>CornOnFootCarbine</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
								<MinSeverityMultiplier value="0.0f"/>
								<MaxSeverityMultiplier value="3.0f"/>
							</DispatchGroup>
						</DispatchPedGroups>
					</DispatchPeds>
				
					<PhaseEndConditions>
						<Condition type="CAIConditionReferenced">
							<Name>DISPATCH_LOW_SEVERITY_ESCALATION_WILDERNESS</Name>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<!--Switch to Reinforcements phase -->
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>Reinforcements</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<!-- Phase: Reinforcements -->
				<Phase>
					<Name>Reinforcements</Name>
					<GroupMultiplier value="0.3"/>
					<SpawnDelay value="5.0"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>CornOnFootCarbine</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</DispatchPedGroups>
						
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>CornOnFootCarbine</Preset>
								<RandomWeight value="0.75"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
					
					<!-- End the phase if we kill most of the wave -->
					<PhaseEndConditions>
						<Condition type="CAIConditionAnd">
							<Conditions>
								<Condition type="CAIConditionTimeInDispatchPhase">
									<LowerBound value="8000"/>
								</Condition>
								<Condition type="CAIConditionPedsRemainingInCurrentIncident">
									<UpperBound value="1"/>
								</Condition>
							</Conditions>
						</Condition>
					</PhaseEndConditions>
					
					<!-- Loop a couple of times, then enter LastRiders -->
					<NextPhases>
						<PhaseOption>
							<Condition type="CAIConditionNumTimesDispatchPhaseSelected">
								<Phase>Reinforcements</Phase>
								<LowerBound value="2"/>
							</Condition>
							<Name>LastRiders</Name>
						</PhaseOption>
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>Reinforcements</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<!-- Phase: LastRiders -->
				<Phase>
					<Name>LastRiders</Name>
					<GroupMultiplier value="0.3"/>
					<SpawnDelay value="35.00"/>
					
					<DispatchPeds>
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderGuard</Preset>
								<RandomWeight value="0.5"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
				
					
					<!-- End the phase if we kill most of the wave -->
					<PhaseEndConditions>
						<Condition type="CAIConditionAnd">
							<Conditions>
								<Condition type="CAIConditionTimeInDispatchPhase">
									<LowerBound value="25000"/>
								</Condition>
								<Condition type="CAIConditionPedsRemainingInCurrentIncident">
									<UpperBound value="1"/>
								</Condition>
							</Conditions>
						</Condition>
					</PhaseEndConditions>
					
					<NextPhases>
						<!--Switch to CORPhaseControl -->
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>CORPhaseControl</Name>
						</PhaseOption>
					</NextPhases>	
				</Phase>
				
				<Phase>
					<Name>CORPhaseControl</Name>
					
					<PhaseEndConditions>
						<Condition type="CAIConditionOr">
							<Conditions>
								<Condition type="CAIConditionAnd">
									<Conditions>
										<Condition type="CAIConditionPedsRemainingInCurrentIncident">
											<UpperBound value="1"/>
										</Condition>
										<Condition type="CAIConditionTimeInDispatchPhase">
											<LowerBound value="15000"/>
										</Condition>
									</Conditions>
								</Condition>
								<Condition type="CAIConditionAnd">
									<Conditions>
										<Condition type="CAIConditionTimeInDispatchPhase">
											<LowerBound value="3000"/>
										</Condition>
										<Condition type="CAIConditionPedsRemainingInCurrentIncident">
											<UpperBound value="0"/>
										</Condition>
									</Conditions>
								</Condition>
							</Conditions>
						</Condition>
					</PhaseEndConditions>
					
				<!-- Phase: EndlessRiders -->
					<NextPhases>
						<PhaseOption>
							<Condition type="NULL"/>
							<Name>EndlessRiders</Name>
						</PhaseOption>
					</NextPhases>
				</Phase>
				
				<!-- Phase: EndlessRiders -->
				<Phase>
					<Name>EndlessRiders</Name>
					<GroupMultiplier value="0.3"/>
					<SpawnDelay value="20.00"/>
					
					<DispatchPeds>
						<DispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderMouse</Preset>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="2"/>
							</DispatchGroup>
						</DispatchPedGroups>
						<RandomDispatchPedGroups>
							<DispatchGroup>
								<Preset>RiderMouse</Preset>
								<RandomWeight value="0.35f"/>
								<MinNumPeds value="1"/>
								<MaxNumPeds value="1"/>
							</DispatchGroup>
						</RandomDispatchPedGroups>
					</DispatchPeds>
					
					<PhaseEndConditions>
						<Condition type="CAIConditionTimeInDispatchPhase">
							<LowerBound value="15000"/>
						</Condition>
					</PhaseEndConditions>
					
					<!-- Reloop back to CORPhaseControl -->
					<NextPhases>
						<PhaseOption>
							<!-- End Response -->
						</PhaseOption>
					</NextPhases>	
				</Phase>			
			</DispatchPhases>
		</BountyDispatch>
	</BountyResponses>
	<CleanUpDispatchPedPresets>
		<Item>RiderRuralPlains</Item>
	</CleanUpDispatchPedPresets>
</CDispatchData>